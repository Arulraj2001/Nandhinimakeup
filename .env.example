# Supabase Configuration
# The URL of your Supabase project instance (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for browser/client use, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client/browser, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site Configuration
# Canonical public URL of the website (e.g., http://localhost:3000 for local development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO / Indexing Controls
# Controls whether search engines are allowed to crawl and index the site ("true" or "false").
# Default is "false" (disallow all crawling and send noindex headers/tags until official launch).
ALLOW_INDEXING=false
